# slangc's C++ of the look kernels (IN) made the core's (OUT, engine/core/src/look/generated, kept in
# the repository): its float transcendentals (the prelude's F32_sin, F32_pow...) the core's portable
# ones (groomlab::pm, through look_kernels_cpu_support.h's groomlab_pm_*), so the CPU engine rounds
# as the core's operators do on every platform; the support header included first (its atomics,
# mul64); the prelude included by name (third_party/slang), not slangc's absolute path; no line
# directives (a look.slang edit changes only what it changes here); written only when it changes
# (the core rebuilds it then alone).
file(READ "${IN}" text)
string(REGEX REPLACE "F32_(sin|cos|tan|asin|acos|atan2|atan|sinh|cosh|tanh|exp2|exp|log2|log10|log|pow|cbrt)\\(" "groomlab_pm_\\1(" text "${text}")
string(REGEX REPLACE "#include \"[^\"]*slang-cpp-prelude\\.h\"" "#include \"slang-cpp-prelude.h\"" text "${text}")
string(REGEX REPLACE "\n#line [^\n]*" "" text "${text}")
set(text "// SPDX-License-Identifier: Apache-2.0\n// Generated by engine/gpu/CMakeLists.txt from engine/gpu/shaders/look.slang (slangc -target cpp,\n// then cmake/portable_cpu_kernels.cmake). Do not edit: edit look.slang.\n#include \"look_kernels_cpu_support.h\"\n${text}")
set(old "")
if(EXISTS "${OUT}")
    file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
    file(WRITE "${OUT}" "${text}")
endif()
