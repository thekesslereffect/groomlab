    {"name": "width", "type": "Width", "params": {"width": 0.03, "profile": [[0, 1], [0.7, 0.85], [1, 0.35]], "randomness": 0.2}, "ui": {"x": 1680, "y": 0}},
    {"name": "resample", "type": "Resample", "params": {"segments": 6}, "ui": {"x": 1920, "y": 0}},
