{
  "$schema": "./ui.schema.json",
  "version": 1,
  "lists": {
    "groups": {
      "about": "Place and Draw add to the group picked in this list (click a row); brushes edit it. Guides nodes in the graph read groups by name.",
      "bar": [{"id": "group.new", "label": "+ New Group"}],
      "context": ["group.rename", "group.select", "-", {"include": "lists/groups/edits/items"}, "-", "group.color", "group.defaultColor", "group.resetSegments", "group.promoteDemote", {"id": "guides.paste", "label": "Paste Guides Here"}, "-", "group.delete"],
      "edits": {
        "label": "Edit Guides",
        "tip": "Children, mirroring, reparenting, moving between groups, copy and paste, curves, selection",
        "items": [
          "guides.children",
          "-",
          {"submenu": "Mirror", "id": "guides.mirror", "tip": "The selected guides, a group or the whole groom mirrored across X", "items": [
            {"id": "guides.mirrorToOther", "label": "Selected to Other Side"},
            {"id": "guides.mirrorGroup", "label": "Group..."},
            "-",
            {"id": "guides.syncPos", "label": "Whole Groom +X → -X"},
            {"id": "guides.syncNeg", "label": "Whole Groom -X → +X"},
            "-",
            "guides.mirrorSelection"
          ]},
          "-",
          "guides.reparent",
          {"submenu": "Move to Group", "id": "guides.moveToGroup", "items": [{"generator": "guideGroups", "action": "guides.moveToGroup"}, "-", {"id": "guides.newGroupFromSelection", "label": "New Group"}]},
          "guides.copy",
          "guides.paste",
          "guides.fromCurves",
          "guides.clearSelection"
        ]
      }
    },
    "parts": {
      "bar": ["parts.fromCurves", "parts.remove", "parts.clear"],
      "mirror": ["parts.mirrorNegative", "parts.mirrorPositive"]
    },
    "flow": {
      "mirror": ["flow.mirrorNegative", "flow.mirrorPositive"]
    },
    "maps": {
      "bar": [{"id": "map.new", "label": "+ New Map"}, {"id": "map.import", "label": "Import..."}],
      "convert": [{"generator": "choices", "choices": "mapKind", "action": "map.convert", "labelField": "convert"}],
      "image": [
        {"id": "map.relink", "needs": ["map", "map.texture"]},
        {"id": "map.relink", "needs": ["map", "!map.texture"], "tip": "Point the map at another image: a PNG is used in place (painting edits it); a JPEG, TGA, PSD... is copied into the masks folder as a PNG. The map becomes a texture map (what reads it follows)"},
        "map.reloadImage",
        "map.showFile"
      ],
      "context": [
        {"id": "map.rename", "tip": ""},
        {"submenu": "Convert to", "id": "map.convert", "needs": ["map"], "ref": "lists/maps/convert"},
        "map.makeGray",
        "map.makeColor",
        "-",
        {"include": "lists/maps/image"},
        "-",
        {"id": "map.delete", "tip": ""},
        "map.deleteFiles"
      ],
      "forTip": "A map for a setting is made white (the setting as it is), linked to it and picked with the Paint brush on it, in one undo step: strokes paint toward the value, Ctrl toward 0 (on Density: no hair). When the setting reads a map already, that map is picked instead."
    },
    "correctives": {
      "about": "Brushes edit the picked row: the <b>Base groom</b>, a corrective on top of it, or a <b>Sculpt node</b>'s guides. <b>Fix Frame</b> keys a corrective in and out around this frame.",
      "bar": [{"id": "corrective.fixFrame", "label": "◆ Fix Frame"}, {"id": "corrective.new", "label": "+ New"}],
      "row": ["corrective.solo"],
      "context": ["corrective.rename", "-", "corrective.up", "corrective.down", "-", "corrective.goTo", "corrective.keyWeight", "corrective.clearKeys", "-", "corrective.delete"],
      "nodeContext": [{"id": "sculpt.clearEdits", "label": "Clear Edits", "needs": []}]
    },
    "photos": {
      "about": "Each photo is a camera. Line it up with the mesh (<b>Align Photo</b>, or by eye looking through it), then <b>Lock</b> it and groom to it.",
      "bar": [{"id": "photo.import", "label": "+ Import"}, "photo.addView"],
      "context": ["photo.rename", "photo.align", "photo.selectCamera", "-", "photo.remove"],
      "click": ["photo.lookThrough"],
      "pairsBar": ["pairs.solve", "pairs.clear", {"id": "pairs.delete", "glyph": "delete"}],
      "pairsContext": ["pairs.repickPhoto", "pairs.repickMesh", "-", "pairs.delete"]
    }
  }
}
