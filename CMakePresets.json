            "inherits": "maya-devkit",
            "cacheVariables": {
                "MAYA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/maya-devkit-2025",
                "GROOMLAB_PYTHON_ROOT": "$env{USERPROFILE}/groomlab-deps/sdks/python-3.11.4/tools",
                "MTOA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/mtoa-5.4.0-maya2025"
            }
        },
        {
            "name": "ninja-maya2026",
            "displayName": "Windows, Maya 2026 plugin from its devkit (Python 3.11, Qt 6, oneTBB, MtoA 5.6.1.1 / Arnold 7.5.1)",
            "inherits": "maya-devkit",
            "cacheVariables": {
                "MAYA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/maya-devkit-2026",
                "GROOMLAB_PYTHON_ROOT": "$env{USERPROFILE}/groomlab-deps/sdks/python-3.11.9/tools",
                "MTOA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/mtoa-5.6.1.1-maya2026"
            }
        },
        {
            "name": "ninja-maya2027",
            "displayName": "Windows, Maya 2027 plugin from its devkit (Python 3.13, Qt 6, oneTBB, MtoA 5.6.1.1 / Arnold 7.5.1)",
            "inherits": "maya-devkit",
            "cacheVariables": {
                "MAYA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/maya-devkit-2027",
                "GROOMLAB_PYTHON_ROOT": "$env{USERPROFILE}/groomlab-deps/sdks/python-3.13.9/tools",
                "MTOA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/mtoa-5.6.1.1-maya2027"
            }
        },
        {
            "name": "maya-devkit-tests",
            "hidden": true,
            "inherits": "ninja",
            "description": "A newer Maya's plugin built from its devkit with every test, run in that Maya's install (GROOMLAB_MAYA_BIN: mayapy, maya, its TBB DLL) and its MtoA: the tests' port to that Maya, docs/DEVELOPING.md, Other Maya versions",
            "cacheVariables": {
                "GROOMLAB_BUILD_MAYA": "ON",
                "GROOMLAB_GUI_TESTS": "ON"
            }
        },
        {
            "name": "ninja-maya2024-tests",
            "displayName": "Windows, Maya 2024 plugin from its devkit + core + every test, run in the installed Maya 2024 (port in progress)",
            "inherits": "maya-devkit-tests",
            "cacheVariables": {
                "MAYA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/maya-devkit-2024",
                "GROOMLAB_PYTHON_ROOT": "$env{USERPROFILE}/groomlab-deps/sdks/python-3.10.8/tools",
                "GROOMLAB_MAYA_BIN": "C:/Program Files/Autodesk/Maya2024/bin",
                "MTOA_LOCATION": "C:/Program Files/Autodesk/Arnold/maya2024"
            }
        },
        {
            "name": "ninja-maya2025-tests",
            "displayName": "Windows, Maya 2025 plugin from its devkit + core + every test, run in the installed Maya 2025 (port in progress)",
            "inherits": "maya-devkit-tests",
            "cacheVariables": {
                "MAYA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/maya-devkit-2025",
                "GROOMLAB_PYTHON_ROOT": "$env{USERPROFILE}/groomlab-deps/sdks/python-3.11.4/tools",
                "GROOMLAB_MAYA_BIN": "C:/Program Files/Autodesk/Maya2025/bin",
                "MTOA_LOCATION": "C:/Program Files/Autodesk/Arnold/maya2025"
            }
        },
        {
            "name": "ninja-maya2026-tests",
            "displayName": "Windows, Maya 2026 plugin from its devkit + core + every test, run in the installed Maya 2026 (port in progress)",
            "inherits": "maya-devkit-tests",
            "cacheVariables": {
                "MAYA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/maya-devkit-2026",
                "GROOMLAB_PYTHON_ROOT": "$env{USERPROFILE}/groomlab-deps/sdks/python-3.11.9/tools",
                "GROOMLAB_MAYA_BIN": "C:/Program Files/Autodesk/Maya2026/bin",
                "MTOA_LOCATION": "C:/Program Files/Autodesk/Arnold/maya2026"
            }
        },
        {
            "name": "ninja-maya2027-tests",
            "displayName": "Windows, Maya 2027 plugin from its devkit + core + every test, run in the installed Maya 2027 (port in progress)",
            "inherits": "maya-devkit-tests",
            "cacheVariables": {
                "MAYA_LOCATION": "$env{USERPROFILE}/groomlab-deps/sdks/maya-devkit-2027",
                "GROOMLAB_PYTHON_ROOT": "$env{USERPROFILE}/groomlab-deps/sdks/python-3.13.9/tools",
                "GROOMLAB_MAYA_BIN": "C:/Program Files/Autodesk/Maya2027/bin",
                "MTOA_LOCATION": "C:/Program Files/Autodesk/Arnold/maya2027"
            }
        },
        {
            "name": "ninja-core",
            "displayName": "Windows, core only (no Maya, Ninja)",
            "inherits": "ninja",
            "cacheVariables": { "GROOMLAB_BUILD_MAYA": "OFF", "GROOMLAB_BUILD_PYTHON": "OFF" }
        },
        {
            "name": "wasm",
            "displayName": "WebAssembly: the core in the browser (Emscripten, single-threaded; docs/WEB.md)",
            "description": "Run from a shell where emsdk_env has set EMSDK, with ninja on PATH. Writes groomlab.js and groomlab.wasm to web/public/wasm",
            "inherits": "base",
            "generator": "Ninja",
            "toolchainFile": "$env{EMSDK}/upstream/emscripten/cmake/Modules/Platform/Emscripten.cmake",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "GROOMLAB_BUILD_WEB": "ON",
                "GROOMLAB_USE_TBB": "OFF",
                "GROOMLAB_BUILD_TESTS": "OFF",
                "GROOMLAB_BUILD_PYTHON": "OFF",
                "GROOMLAB_BUILD_CLI": "OFF",
                "GROOMLAB_BUILD_CAPI": "OFF",
                "GROOMLAB_BUILD_BLENDER_HELPER": "OFF",
                "GROOMLAB_BUILD_ALEMBIC": "OFF",
                "GROOMLAB_BUILD_MAYA": "OFF",
                "GROOMLAB_BUILD_ARNOLD": "OFF",
                "GROOMLAB_BUILD_PROCEDURAL": "OFF",
                "GROOMLAB_BUILD_RENDERMAN": "OFF"
            }
        },
        {
            "name": "linux",
            "hidden": true,
            "inherits": "base",
            "description": "Linux with GCC or Clang and Ninja (tools/dev/linux_build.sh; from Windows: tools/dev/linux_build.ps1 builds in WSL)",
            "generator": "Ninja",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "GROOMLAB_BUILD_MAYA": "OFF"
            }
        },
        {
            "name": "linux-maya2022",
            "displayName": "Linux, Maya 2022 plugin + core",
            "inherits": "linux",
            "cacheVariables": {
                "GROOMLAB_BUILD_MAYA": "ON",
                "MAYA_LOCATION": "/usr/autodesk/maya2022",
                "MTOA_LOCATION": "/usr/autodesk/arnold/maya2022"
            }
        },
        {
            "name": "linux-core",
            "displayName": "Linux, farm and pipeline build: core, C API + samples, groomlab-cli, Python module, tests (no Maya)",
            "inherits": "linux"
        },
        {
            "name": "linux-coverage",
            "displayName": "Linux, core with gcov coverage",
            "inherits": "linux-core",
            "binaryDir": "${sourceDir}/build/linux-coverage",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "GROOMLAB_COVERAGE": "ON",
                "GROOMLAB_BUILD_PYTHON": "OFF"
            }
        },
        {
            "name": "linux-asan",
            "displayName": "Linux, core and tests under AddressSanitizer + UBSan (memory errors MSVC's heap hides)",
            "inherits": "linux-core",
            "cacheVariables": {
                "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined",
                "CMAKE_C_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
                "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined",
                "CMAKE_MODULE_LINKER_FLAGS": "-fsanitize=address,undefined",
                "GROOMLAB_BUILD_PYTHON": "OFF",
                "GROOMLAB_BUILD_BLENDER_HELPER": "OFF"
            }
        },
        {
            "name": "macos",
            "hidden": true,
            "inherits": "base",
            "description": "macOS on Apple silicon with Apple Clang (Xcode) and Ninja: docs/MACOS.md. 13.3: the first macOS whose libc++ has std::to_chars for floats (the .groom writer); Maya 2024 to 2027 and Qt 6.8 run there; the RenderMan procedural off: RenderMan 27.3 for macOS is Intel only, and the port is Apple silicon only (it waits for RenderMan 28)",
            "generator": "Ninja",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_C_COMPILER": "/usr/bin/clang",
                "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
                "CMAKE_OSX_ARCHITECTURES": "arm64",
                "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3",
                "CMAKE_PREFIX_PATH": "/opt/homebrew",
                "GROOMLAB_BUILD_MAYA": "OFF",
                "GROOMLAB_BUILD_RENDERMAN": "OFF"
            }
        },
        {
            "name": "macos-core",
            "displayName": "macOS, core, C API + samples, groomlab-cli, Python module, Blender helper, tests (no Maya)",
            "inherits": "macos"
        },
        {
            "name": "macos-app",
            "displayName": "macOS, core + the standalone app (Qt 6.8.3 from the Qt installer or aqtinstall in ~/Qt)",
            "inherits": "macos",
            "cacheVariables": {
                "GROOMLAB_BUILD_APP": "ON",
                "GROOMLAB_QT_DIR": "$env{HOME}/Qt/6.8.3/macos"
            }
        },
        {
            "name": "macos-release",
            "displayName": "macOS, what ships outside Maya: the app, groomlab-cli, the Blender helper and the Arnold procedural, without TBB",
            "description": "No TBB (Homebrew's needs the newest macOS): the core runs on its own threads (parallel_pool.cpp). The procedural against MtoA 2024's Arnold 7.2, the oldest, which newer Arnold 7 loads: docs/MACOS.md",
            "inherits": "macos",
            "cacheVariables": {
                "GROOMLAB_USE_TBB": "OFF",
                "GROOMLAB_BUILD_APP": "ON",
                "GROOMLAB_QT_DIR": "$env{HOME}/Qt/6.8.3/macos",
                "GROOMLAB_BUILD_PROCEDURAL": "ON",
                "MTOA_LOCATION": "/Applications/Autodesk/Arnold/mtoa/2024"
            }
        },
        {
            "name": "macos-maya-devkit",
            "hidden": true,
            "inherits": "macos",
            "description": "A Maya version's plugin, its Python module and MtoA translator on macOS: MAYA_LOCATION the Maya install (include/maya; a devkit works too), GROOMLAB_MAYA_APP its Maya.app/Contents (its libraries, mayapy): docs/MACOS.md",
            "cacheVariables": {
                "GROOMLAB_BUILD_MAYA": "ON",
                "GROOMLAB_BUILD_TESTS": "OFF",
                "GROOMLAB_BUILD_CLI": "OFF",
                "GROOMLAB_BUILD_CAPI": "OFF",
                "GROOMLAB_BUILD_BLENDER_HELPER": "OFF",
                "GROOMLAB_BUILD_PROCEDURAL": "OFF",
                "GROOMLAB_BUILD_RENDERMAN": "OFF"
            }
        },
        {
            "name": "macos-maya2024",
            "displayName": "macOS, Maya 2024 plugin (Python 3.10, Qt 5 and PySide2, TBB 2020, MtoA 5.3+)",
            "inherits": "macos-maya-devkit",
            "cacheVariables": {
                "MAYA_LOCATION": "/Applications/Autodesk/maya2024",
                "GROOMLAB_MAYA_APP": "/Applications/Autodesk/maya2024/Maya.app/Contents",
                "MTOA_LOCATION": "/Applications/Autodesk/Arnold/mtoa/2024"
            }
        },
        {
            "name": "macos-maya2025",
