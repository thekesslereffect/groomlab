            "inherits": "macos-maya-devkit",
            "cacheVariables": {
                "MAYA_LOCATION": "/Applications/Autodesk/maya2026",
                "GROOMLAB_MAYA_APP": "/Applications/Autodesk/maya2026/Maya.app/Contents",
                "MTOA_LOCATION": "/Applications/Autodesk/Arnold/mtoa/2026"
            }
        },
        {
            "name": "macos-maya2027",
            "displayName": "macOS, Maya 2027 plugin (Python 3.13, Qt 6, oneTBB, MtoA for 2027)",
            "inherits": "macos-maya-devkit",
            "cacheVariables": {
                "MAYA_LOCATION": "/Applications/Autodesk/maya2027",
                "GROOMLAB_MAYA_APP": "/Applications/Autodesk/maya2027/Maya.app/Contents",
                "MTOA_LOCATION": "/Applications/Autodesk/Arnold/mtoa/2027"
            }
        },
        {
            "name": "macos-maya-tests",
            "hidden": true,
            "inherits": "macos-maya-devkit",
            "description": "A Maya version's plugin with the core and every test, run in that Maya's install and its MtoA, as Windows' ninja-maya20XX-tests: GROOMLAB_MAYA_BIN is Maya.app/Contents/bin (mayapy and maya live there on macOS); docs/MACOS.md, Test tiers",
            "cacheVariables": {
                "GROOMLAB_BUILD_TESTS": "ON",
                "GROOMLAB_GUI_TESTS": "ON",
                "GROOMLAB_BUILD_CLI": "ON",
                "GROOMLAB_BUILD_CAPI": "ON",
                "GROOMLAB_BUILD_BLENDER_HELPER": "ON",
                "GROOMLAB_BUILD_PROCEDURAL": "ON"
            }
        },
        {
            "name": "macos-maya2024-tests",
            "displayName": "macOS, Maya 2024 plugin + core + every test, run in the installed Maya 2024",
            "inherits": ["macos-maya-tests", "macos-maya2024"],
            "cacheVariables": { "GROOMLAB_MAYA_BIN": "/Applications/Autodesk/maya2024/Maya.app/Contents/bin" }
        },
        {
            "name": "macos-maya2025-tests",
            "displayName": "macOS, Maya 2025 plugin + core + every test, run in the installed Maya 2025",
            "inherits": ["macos-maya-tests", "macos-maya2025"],
            "cacheVariables": { "GROOMLAB_MAYA_BIN": "/Applications/Autodesk/maya2025/Maya.app/Contents/bin" }
        },
        {
            "name": "macos-maya2026-tests",
            "displayName": "macOS, Maya 2026 plugin + core + every test, run in the installed Maya 2026",
            "inherits": ["macos-maya-tests", "macos-maya2026"],
            "cacheVariables": { "GROOMLAB_MAYA_BIN": "/Applications/Autodesk/maya2026/Maya.app/Contents/bin" }
        },
        {
            "name": "macos-maya2027-tests",
            "displayName": "macOS, Maya 2027 plugin + core + every test, run in the installed Maya 2027",
            "inherits": ["macos-maya-tests", "macos-maya2027"],
            "cacheVariables": { "GROOMLAB_MAYA_BIN": "/Applications/Autodesk/maya2027/Maya.app/Contents/bin" }
