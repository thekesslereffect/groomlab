{
  "version": 1,
  "size": 20.0,
  "about": {"title": "Painted maps", "description": "Paint one map to control where the hair clumps, where it frizzes and how long it grows.", "category": "Techniques"},
  "exposed": [
    {"node": "clump", "param": "size", "name": "clumpSize"},
    {"node": "clump", "param": "strength", "name": "clumpStrength"},
    {"node": "frizzNoise", "param": "amplitude", "name": "frizzAmount"},
    {"node": "length", "param": "keep", "name": "lengthFactor"},
    {"node": "width", "param": "width", "name": "width"}
  ],
  "requires": {"maps": [{"name": "groomMasks", "kind": "vertices", "color": [1.0, 0.1, 1.0]}]},
  "nodes": [
    {"name": "scalp", "type": "Scalp", "ui": {"x": 0, "y": 0}},
    {"name": "guides", "type": "Guides", "ui": {"x": 0, "y": 180}},
    {"name": "scatter", "type": "Scatter", "params": {"density": 80.0, "length": 15.0}, "ui": {"x": 240, "y": 0}},
    {"name": "interpolate", "type": "Interpolate", "ui": {"x": 480, "y": 0}},
    {"name": "clump", "type": "Clump", "version": 1, "params": {"clumpBy": "size", "size": 0.9, "strength": 1.0, "profile": [[0, 0], [0.4, 0.3], [1, 0.9]]}, "paramInputs": ["strength"], "ui": {"x": 960, "y": 0}},
    {"name": "frizzNoise", "type": "Noise", "params": {"fraction": 1.0, "amplitude": 0.15, "frequency": 9.0, "octaves": 1}, "paramInputs": ["fraction"], "ui": {"x": 1200, "y": 0}},
    {"name": "length", "type": "Length", "params": {"keep": 1.0}, "paramInputs": ["keep"], "ui": {"x": 1440, "y": 0}},
    {"name": "groomMasks", "type": "Map", "params": {"name": "groomMasks"}, "ui": {"x": 720, "y": 360}},
    {"name": "width", "type": "Width", "params": {"width": 0.007, "profile": [[0, 1], [0.75, 0.75], [1, 0.25]]}, "ui": {"x": 1920, "y": 0}},
    {"name": "color", "type": "HairColor", "params": {"melanin": 0.65, "redness": 0.2, "melaninRandom": 0.08}, "ui": {"x": 1680, "y": 0}},
    {"name": "resample", "type": "Resample", "params": {"segments": 16}, "ui": {"x": 2160, "y": 0}},
    {"name": "output", "type": "Output", "ui": {"x": 2400, "y": 0}}
  ],
  "connections": [
    {"from": "scalp", "to": "scatter", "input": "scalp"},
    {"from": "scatter", "to": "interpolate", "input": "strands"},
    {"from": "guides", "to": "interpolate", "input": "guides"},
    {"from": "scalp", "to": "interpolate", "input": "scalp"},
    {"from": "interpolate", "to": "clump", "input": "strands"},
    {"from": "clump", "to": "frizzNoise", "input": "strands"},
    {"from": "frizzNoise", "to": "length", "input": "strands"},
    {"from": "length", "to": "color", "input": "strands"},
    {"from": "width", "to": "resample", "input": "strands"},
    {"from": "resample", "to": "output", "input": "strands"},
    {"from": "groomMasks", "to": "clump", "input": "strength", "output": "r"},
    {"from": "groomMasks", "to": "frizzNoise", "input": "fraction", "output": "g"},
    {"from": "groomMasks", "to": "length", "input": "keep", "output": "b"},
    {"from": "color", "to": "width", "input": "strands"}
  ],
  "output": "output"
}
