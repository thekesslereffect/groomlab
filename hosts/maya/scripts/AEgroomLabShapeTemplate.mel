// Attribute Editor layout for groomLabShape.
//
// The groom stores its graph, guides, parts and layout as JSON strings; shown
// raw they made huge text fields that broke the Attribute Editor's scrolling.
// They are hidden here: edit them with the Graph Editor and the Groom Tools
// (buttons below).

global proc AEgroomLabButtonsNew(string $attr)
{
    setUITemplate -pushTemplate attributeEditorTemplate;
    rowLayout -numberOfColumns 3 -adjustableColumn 3 -columnWidth3 130 130 10
        -columnAttach3 "both" "both" "both" -columnOffset3 2 2 0 groomLabAEButtons;
        button -label "Groom Tools" -height 28 -annotation "Brushes, guide groups, painted maps, sculpt layers"
            -command "python(\"import groomlab.ui.palette as p; p.show()\")";
        button -label "Graph Editor" -height 28 -annotation "The look: the groom's node graph"
            -command "python(\"import groomlab.ui.graph_editor as g; g.show()\")";
        text -label "";
    setParent ..;
    setUITemplate -popTemplate;
}

global proc AEgroomLabButtonsReplace(string $attr)
{
}

global proc AEgroomLabInputsNew(string $attr) { python("import groomlab.ui.ae as a; a.inputs_new('" + $attr + "')"); }
global proc AEgroomLabInputsReplace(string $attr) { python("import groomlab.ui.ae as a; a.inputs_replace('" + $attr + "')"); }
global proc AEgroomLabScaleNew(string $attr) { python("import groomlab.ui.ae as a; a.scale_new('" + $attr + "')"); }
global proc AEgroomLabScaleReplace(string $attr) { python("import groomlab.ui.ae as a; a.scale_replace('" + $attr + "')"); }
global proc AEgroomLabControlsNew(string $attr) { python("import groomlab.ui.ae as a; a.controls_new('" + $attr + "')"); }
global proc AEgroomLabControlsReplace(string $attr) { python("import groomlab.ui.ae as a; a.controls_replace('" + $attr + "')"); }
global proc AEgroomLabColorNew(string $attr) { python("import groomlab.ui.ae as a; a.color_new('" + $attr + "')"); }
global proc AEgroomLabColorReplace(string $attr) { python("import groomlab.ui.ae as a; a.color_replace('" + $attr + "')"); }

global proc AEgroomLabShapeTemplate(string $nodeName)
{
    // The Controls section's sliders (keyable ctl_ attributes Control nodes add): folded while there are none.
    string $controls[] = `listAttr -userDefined -string "ctl_*" $nodeName`;
    editorTemplate -beginScrollLayout;

        // The groom at a glance, and the two windows everything is done in.
        editorTemplate -beginLayout "Groom" -collapse 0;
            editorTemplate -callCustom "AEgroomLabButtonsNew" "AEgroomLabButtonsReplace" "outStrandCount";
            editorTemplate -addControl "previewDensity";
            editorTemplate -annotation ("Preview point budget, in millions of strand points: the most the viewport "
                + "holds (each groom keeps a copy, the draw buffers more); past it the preview thins itself. "
                + "0: no limit") -addControl "previewPointBudget";
            editorTemplate -addControl "outStrandCount";
            editorTemplate -addControl "locked";
        editorTemplate -endLayout;

        // What the groom is made from: always visible, and changeable here.
        editorTemplate -beginLayout "Inputs" -collapse 0;
            editorTemplate -callCustom "AEgroomLabInputsNew" "AEgroomLabInputsReplace" "inMesh";
            editorTemplate -annotation ("Evaluate on the rest mesh and carry each strand rigidly with its root: fast "
                + "per frame, the rest shape kept. Needs a rest mesh. See the docs (Rigs and follow-the-scalp).")
                -addControl "followScalp";
            editorTemplate -annotation ("What the groom's sizes grow with. Surface Area: the scalp's surface at the start "
                + "frame (survives Freeze Transformations). Transform Only: its transform and rig scale (survives "
                + "remodelling). Off: fixed scene units.")
                -addControl "scaleSource";
            editorTemplate -callCustom "AEgroomLabScaleNew" "AEgroomLabScaleReplace" "groomScale";
        editorTemplate -endLayout;
        // Sliders that Control nodes add (keyable ctl_ attributes).
        editorTemplate -beginLayout "Controls" -collapse (size($controls) == 0);
            editorTemplate -callCustom "AEgroomLabControlsNew" "AEgroomLabControlsReplace" "graph";
        editorTemplate -endLayout;
        // The hair's color: the HairColor node making the output, its everyday params here.
        editorTemplate -beginLayout "Hair Color" -collapse 0;
            editorTemplate -callCustom "AEgroomLabColorNew" "AEgroomLabColorReplace" "graph";
        editorTemplate -endLayout;

        // What shows in the viewport: the everyday switches open, the fine tuning folded.
        editorTemplate -beginLayout "Display" -collapse 0;
            editorTemplate -addControl "displayHair";
            editorTemplate -addControl "displayGuides";
            editorTemplate -addControl "displayFlow";
            editorTemplate -addControl "displayTubes";
            editorTemplate -addControl "displayInstances";
            editorTemplate -addSeparator;
            editorTemplate -addControl "strandColorMode";
            editorTemplate -addControl "strandColorMin";
            editorTemplate -addControl "strandColorMax";
            editorTemplate -beginLayout "Guides" -collapse 1;
                editorTemplate -addControl "displayOverlaysOnTop";
                editorTemplate -addControl "guideWidth";
                editorTemplate -addControl "guidePoints";
                editorTemplate -addControl "guideSmoothing";
                editorTemplate -addControl "isolateGroup";
                editorTemplate -addControl "guideColorMode";
            editorTemplate -endLayout;
            editorTemplate -beginLayout "Strand Shading" -collapse 1;
                editorTemplate -addControl "displayLighting";
                editorTemplate -addControl "displayHairShading";
                editorTemplate -addControl "displaySelfShadowing";
                editorTemplate -addControl "displayStrandVariation";
                editorTemplate -addControl "displayShadows";
                editorTemplate -addControl "displayWidthCoverage";
                editorTemplate -addControl "displayCoverageDensity";
                editorTemplate -addControl "displayClumpLod";
                editorTemplate -addControl "clumpLodError";
                editorTemplate -addControl "useMaterialColor";
                editorTemplate -addControl "displayColor";
                editorTemplate -addSeparator;
                editorTemplate -addControl "displayRibbons";
                editorTemplate -addControl "ribbonWidthScale";
            editorTemplate -endLayout;
        editorTemplate -endLayout;

        editorTemplate -beginLayout "Sculpting" -collapse 1;
            editorTemplate -addControl "sculptDisplay";
            editorTemplate -addControl "sculptDensity";
            editorTemplate -addControl "softSelectRadius";
        editorTemplate -endLayout;

        editorTemplate -beginLayout "Game Cards" -collapse 1;
            editorTemplate -addControl "displayCards";
            editorTemplate -addControl "displayCardTextures";
            editorTemplate -addControl "cardDensity";
        editorTemplate -endLayout;

        editorTemplate -beginLayout "Rendering" -collapse 1;
            editorTemplate -addControl "renderMode";
            editorTemplate -addControl "groomFile";
            // Render overrides: the render (Arnold, exports with render overrides) changes them, the
            // viewport and the groom stay as groomed.
            editorTemplate -beginLayout "Render Overrides" -collapse 1;
                editorTemplate -annotation ("The share of the strands rendered, by the preview's thinning: the same "
                                            + "look with fewer strands (1: every strand)") -addControl "renderDensity";
                editorTemplate -annotation "Times every strand's width in renders" -addControl "renderWidthScale";
                editorTemplate -annotation ("Each strand scaled about its root in renders, shape and all (a "
                                            + "Transform node's scale): 0.5 renders it at half size") -addControl "renderLengthScale";
            editorTemplate -endLayout;
            editorTemplate -beginLayout "Level of Detail" -collapse 1;
                editorTemplate -addControl "lodDistance";
                editorTemplate -addControl "lodNear";
                editorTemplate -addControl "lodFar";
                editorTemplate -addControl "lodMinDensity";
                editorTemplate -addControl "lodWidthCompensation";
                editorTemplate -addSeparator;
                editorTemplate -addControl "cameraCull";
                editorTemplate -addControl "cullMargin";
                editorTemplate -addSeparator;
                editorTemplate -addControl "backfaceCull";
                editorTemplate -addControl "backfaceAngle";
            editorTemplate -endLayout;
        editorTemplate -endLayout;

        // Stored data and plumbing: edited through GroomLab's tools, not here.
        string $hidden[] = {"graph", "graphUi", "guideData", "partData", "guideSelection", "lastError", "brushTick",
                            "viewNode", "inMesh", "restMesh", "guideCurves", "simGuides", "guideCache",
                            "guideCacheObject", "time", "outCards", "correctiveData", "flowData",
                            // set by the Groom Tools (the groups' eyes, the color by layer, the shot's
                            // sculpt), the display's color source by its mode: not settings to type
                            "hiddenGuideGroups", "guideColorLayer", "strandColorSource", "shotSculpt", "shotLayer"};
        for ($attr in $hidden) editorTemplate -suppress $attr;
        // Controls show in their own section, not under Extra Attributes.
        for ($attr in $controls) editorTemplate -suppress $attr;

        AEshapeTemplate $nodeName;
        editorTemplate -addExtraControls;

    editorTemplate -endScrollLayout;
}
