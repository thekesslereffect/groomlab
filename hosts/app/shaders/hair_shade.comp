#version 440
// SPDX-License-Identifier: Apache-2.0
#extension GL_GOOGLE_include_directive : require

// The visibility buffer's deferred shading (lookdev_renderer.cpp, HairPath::Visibility): one
// thread a pixel. The pixel's visible fragment (hair_raster.comp: its segment and where on it) is
// shaded once, as hair_lookdev.frag shades a fragment (hair_shading.glsl), the number of hairs
// in each light's way read from the voxel volumes (hair_volume.comp: one trilinear look-up a light),
// and written premultiplied by the pixel's alpha, 1 - exp(-tau) of every fragment's coverage
// (order independent), for hair_composite.frag to lay over the surfaces.

layout(local_size_x = 8, local_size_y = 8) in;

#include "../../../engine/gpu/shaders/hair_bsdf.glsl"
#include "../../../engine/gpu/shaders/line_coverage.glsl"
#include "hair_shading.glsl"
#include "hair_vis.glsl"

layout(binding = 9) uniform sampler2D pointColorsTexture;  // (r, g, b, iridescence) a point, or one texel (hair.vert)
layout(rgba16f, binding = 7) uniform writeonly image2D hairImage;
// The hairs in the way of each light (and of the sky, for the ambient occlusion), from the voxel
// grid's corner to its far corner (lookdev_renderer.cpp's kVolume*).
layout(binding = 34) uniform sampler3D volume0;
layout(binding = 35) uniform sampler3D volume1;
layout(binding = 36) uniform sampler3D volume2;
layout(binding = 37) uniform sampler3D volume3;

float volumeCount(int which, vec3 pos, vec3 toward) {
    // A voxel on toward the light: the strand's own voxel does not shadow it.
    vec3 uvw = (pos + toward * voxelScale.w - voxelLo.xyz) * voxelScale.xyz;
    if (any(lessThan(uvw, vec3(0.0))) || any(greaterThan(uvw, vec3(1.0)))) return 0.0;
    float v = which == 0 ? textureLod(volume0, uvw, 0.0).r : which == 1 ? textureLod(volume1, uvw, 0.0).r
            : which == 2 ? textureLod(volume2, uvw, 0.0).r : textureLod(volume3, uvw, 0.0).r;
    return v;
}

void main() {
    ivec2 px = ivec2(gl_GlobalInvocationID.xy);
    int rowLo = params.w > 0.5 ? int(target.w - target.y) : 0;
    if (px.x >= int(target.x) || px.y >= int(target.y)) return;
    px.y += rowLo;
    uint at = (uint(px.y) * uint(target.z) + uint(px.x)) * 4u;
    uint key = pix[at];
    if (key == kNoHair) {
        imageStore(hairImage, px, vec4(0.0));
        return;
    }
    float tau = float(pix[at + 1u]) / kTauScale;
    float alpha = 1.0 - exp(-tau);
    uint p = pix[at + 2u];
    vec2 where = unpackUnorm2x16(pix[at + 3u]);
    float t = where.x;

    vec4 a0 = fetch(pointsTexture, p);
    vec4 a1 = fetch(pointsTexture, p + 1u);
    uint strand = hairStrandOf(p);
    vec4 d0 = fetch(strandsTexture, strand * 3u);
    vec4 d1 = fetch(strandsTexture, strand * 3u + 1u);
    vec4 d2 = fetch(strandsTexture, strand * 3u + 2u);
    uint first = uint(d0.w + 0.5), count = uint(d1.w + 0.5);
    bool ownColors = textureSize(pointColorsTexture, 0).x == 4096;
    vec4 own0 = ownColors ? fetch(pointColorsTexture, p) : vec4(d1.rgb, 0.0);
    vec4 own1 = ownColors ? fetch(pointColorsTexture, p + 1u) : own0;
    // (The iridescence and wetness unpacked at each point, then mixed: packed, they would not.)
    vec2 look = mix(hairLookAlpha(own0.a, 0.0), hairLookAlpha(own1.a, 0.0), t);
    vec3 ownRgb = mix(own0.rgb, own1.rgb, t);

    HairPoint h;
    h.P = mix(a0.xyz, a1.xyz, t);
    vec3 tangent = mix(hairTangent(p, first, count), hairTangent(p + 1u, first, count), t);
    h.T = dot(tangent, tangent) > 1e-12 ? normalize(tangent) : normalize(a1.xyz - a0.xyz + vec3(1e-9));
    h.V = normalize(eyeFrame.xyz - h.P);
    h.side = where.y * 2.0 - 1.0;
    h.pigment = vec4(d0.x, d0.y, look.x, look.y);
    h.rgb = ownRgb;
    h.rootNormal = d2.xyz;
    h.random = d0.z;

    bool stochastic = mod(specTRT.w, 2.0) >= 1.0;
    bool shadows = mod(floor(specTRT.w / 2.0), 2.0) >= 1.0;
    bool ao = mod(floor(specTRT.w / 4.0), 2.0) >= 1.0;
    vec3 rnd = random3(uvec3(uvec2(px), uint(eye.w)));
    bool volumes = voxelLo.w > 0.5;
    float lightCount[3];
    bool lightMapped[3];
    for (int i = 0; i < 3; ++i) {
        lightMapped[i] = shadows && lightDir[i].w > 0.5 && lightColor[i].w > 0.5;
        lightCount[i] = lightMapped[i] && volumes ? volumeCount(i, h.P, lightDir[i].xyz) : 0.0;
    }
    float skyCount = ao && volumes ? volumeCount(3, h.P, voxelParams.yzw) : 0.0;
    vec3 result = hairShade(h, lightCount, lightMapped, skyCount, rnd.x * 6.2831853);
    imageStore(hairImage, px, vec4(result * alpha, alpha));
}
