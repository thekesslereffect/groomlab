{
  "version": 1,
  "about": {"title": "Head simulation", "description": "The simulation check on head_scalp.obj (make_sim_scene.py turns it as a scalp cache): guides grown from the scalp and combed down (a sparse Scatter, ToGuides), simulated (Simulate: from frame -24, so the hair settles before the shot; gravity, the head's turns, collisions with the scalp), the strands interpolated from them, clumped, broken up with noise, colored brown and tapered."},
  "nodes": [
    {"name": "scalp", "type": "Scalp"},
    {"name": "guideRoots", "type": "Scatter", "params": {"density": 0.6, "length": 14.0, "seed": 7}},
    {"name": "guideCombAlong", "type": "Bend", "params": {"angle": 56.0, "along": "direction", "direction": [0.0, -1.0, 0.0]}},
    {"name": "guideCombDown", "type": "Gravity", "params": {"strength": 0.95}},
    {"name": "guideCollide", "type": "Collide", "params": {"offset": 0.15, "maxDepth": 30.0, "iterations": 3}},
    {"name": "toGuides", "type": "ToGuides"},
    {"name": "simulate", "type": "Simulate", "params": {"bend": 0.55, "damping": 0.12, "drag": 0.05, "collisionOffset": 0.2, "friction": 0.3, "startFrame": -24}},
    {"name": "scatter", "type": "Scatter", "params": {"density": 120.0, "length": 14.0}},
    {"name": "interpolate", "type": "Interpolate"},
    {"name": "collide", "type": "Collide", "params": {"offset": 0.08, "maxDepth": 30.0, "iterations": 2}},
    {"name": "clump", "type": "Clump", "version": 1, "params": {"count": 400, "strength": 0.55, "profile": [[0, 0], [0.4, 0.5], [1, 1]]}},
    {"name": "noise", "type": "Noise", "params": {"amplitude": 0.2, "frequency": 2.5}},
    {"name": "color", "type": "HairColor", "params": {"melanin": 0.35, "redness": 0.2, "melaninRandom": 0.1}},
    {"name": "width", "type": "Width", "params": {"width": 0.007, "profile": [[0, 1], [1, 0.3]]}},
    {"name": "resample", "type": "Resample", "params": {"segments": 15, "mode": "even"}},
    {"name": "output", "type": "Output"}
  ],
  "connections": [
    {"from": "scalp", "to": "guideRoots", "input": "scalp"},
    {"from": "guideRoots", "to": "guideCombAlong", "input": "strands"},
    {"from": "guideCombAlong", "to": "guideCombDown", "input": "strands"},
    {"from": "guideCombDown", "to": "guideCollide", "input": "strands"},
    {"from": "scalp", "to": "guideCollide", "input": "scalp"},
    {"from": "guideCollide", "to": "toGuides", "input": "strands"},
    {"from": "toGuides", "to": "simulate", "input": "guides"},
    {"from": "scalp", "to": "scatter", "input": "scalp"},
    {"from": "scatter", "to": "interpolate", "input": "strands"},
    {"from": "simulate", "to": "interpolate", "input": "guides"},
    {"from": "scalp", "to": "interpolate", "input": "scalp"},
    {"from": "interpolate", "to": "collide", "input": "strands"},
    {"from": "scalp", "to": "collide", "input": "scalp"},
    {"from": "collide", "to": "clump", "input": "strands"},
    {"from": "clump", "to": "noise", "input": "strands"},
    {"from": "noise", "to": "color", "input": "strands"},
    {"from": "color", "to": "width", "input": "strands"},
    {"from": "width", "to": "resample", "input": "strands"},
    {"from": "resample", "to": "output", "input": "strands"}
  ],
  "output": "output"
}
